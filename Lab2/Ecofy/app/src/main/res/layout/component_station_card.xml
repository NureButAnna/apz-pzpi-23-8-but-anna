<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Tags -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tag_green"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Скло"
            android:textColor="#41B87A"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/tag_blue"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Папір"
            android:textColor="#5D9CEC"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/tag_yellow"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Пластик"
            android:textColor="#E5B93D"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Address -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="вул. Зелена, 18"
        android:textColor="#222222"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Collection time -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Вивіз: Сьогодні, 18:00"
        android:textColor="#B3B3B3"
        android:textSize="14sp" />

    <!-- Progress header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fill_level"
            android:textColor="#B0B0B0"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85%"
            android:textColor="#F39C12"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="85"
        android:progressTint="#F39C12" />

</LinearLayout>